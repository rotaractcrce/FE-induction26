{
  // Cloudflare Workers config. To deploy for real:
  //   1. `npx wrangler d1 create fe-induction26` and paste the returned database_id below
  //   2. `npx wrangler secret put ADMIN_USER` / `npx wrangler secret put ADMIN_PASSWORD`
  //      (the vars below are dev-only fallbacks — remove them before going live)
  "name": "fe-induction26",
  "account_id": "407e4e2e42975af1179067fb19cba01e",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fe-induction26",
      "database_id": "0da9610f-bd85-414a-b41c-38f17a0bf722"
    }
  ]
}
